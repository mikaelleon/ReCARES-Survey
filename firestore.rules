rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function adminDoc(uid) {
      return get(/databases/$(database)/documents/admins/$(uid)).data;
    }

    function isActiveSuperadmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        && adminDoc(uid).role == 'superadmin'
        && adminDoc(uid).status == 'active';
    }

    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc(request.auth.uid).status == 'active';
    }

    function isActiveProponentOrSuperadmin() {
      return isActiveAdmin()
        && (adminDoc(request.auth.uid).role == 'admin'
          || adminDoc(request.auth.uid).role == 'superadmin');
    }

    function isActiveAdviserOrSuperadmin() {
      return isActiveAdmin()
        && (adminDoc(request.auth.uid).role == 'adviser'
          || adminDoc(request.auth.uid).role == 'superadmin');
    }

    function staffRole() {
      return adminDoc(request.auth.uid).role;
    }

    function feedbackSeverityOk(value) {
      return value == 'suggestion' || value == 'required_fix' || value == 'approved';
    }

    function feedbackTargetOk(value) {
      return value == 'note' || value == 'question' || value == 'instrument';
    }

    function feedbackCommentOk(value) {
      return value is string && value.size() >= 5 && value.size() <= 1000;
    }

    function feedbackParent(parentId) {
      return get(/databases/$(database)/documents/adviserFeedback/$(parentId)).data;
    }

    function feedbackNoteTargetOk() {
      return request.resource.data.targetType != 'note'
        || exists(/databases/$(database)/documents/findingNotes/$(request.resource.data.targetId));
    }

    function feedbackAuthorOk() {
      return request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == staffRole()
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 200
        && feedbackTargetOk(request.resource.data.targetType)
        && feedbackCommentOk(request.resource.data.comment)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.edited == false;
    }

    function feedbackRootCreateOk() {
      return isActiveAdviserOrSuperadmin()
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetId', 'comment', 'severity', 'status', 'parentId',
          'authorUid', 'authorName', 'authorRole', 'createdAt', 'updatedAt',
          'resolvedAt', 'replyCount', 'edited'
        ])
        && request.resource.data.parentId == null
        && request.resource.data.status == 'open'
        && request.resource.data.resolvedAt == null
        && request.resource.data.replyCount == 0
        && feedbackSeverityOk(request.resource.data.severity)
        && feedbackAuthorOk()
        && feedbackNoteTargetOk();
    }

    function feedbackReplyCreateOk() {
      return isActiveAdmin()
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetId', 'comment', 'parentId',
          'authorUid', 'authorName', 'authorRole', 'createdAt', 'updatedAt', 'edited'
        ])
        && request.resource.data.parentId is string
        && request.resource.data.parentId.size() > 0
        && exists(/databases/$(database)/documents/adviserFeedback/$(request.resource.data.parentId))
        && feedbackParent(request.resource.data.parentId).parentId == null
        && feedbackParent(request.resource.data.parentId).status != 'resolved'
        && request.resource.data.targetType == feedbackParent(request.resource.data.parentId).targetType
        && request.resource.data.targetId == feedbackParent(request.resource.data.parentId).targetId
        && feedbackAuthorOk();
    }

    function feedbackCommentEditOk() {
      return resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['comment', 'updatedAt', 'edited'])
        && feedbackCommentOk(request.resource.data.comment)
        && request.resource.data.edited == true
        && request.resource.data.updatedAt == request.time;
    }

    function feedbackStatusChangeOk() {
      return resource.data.parentId == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'resolvedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'open'
            && request.resource.data.status == 'addressed'
            && request.resource.data.resolvedAt == null
            && isActiveAdmin())
          || (resource.data.status == 'addressed'
            && request.resource.data.status == 'resolved'
            && request.resource.data.resolvedAt == request.time
            && isActiveAdviserOrSuperadmin())
          || (resource.data.status == 'resolved'
            && request.resource.data.status == 'open'
            && request.resource.data.resolvedAt == null
            && isActiveAdviserOrSuperadmin())
        );
    }

    function feedbackReplyCountOk() {
      return resource.data.parentId == null
        && isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && resource.data.replyCount is int
        && request.resource.data.replyCount >= 0
        && (
          request.resource.data.replyCount == resource.data.replyCount + 1
          || request.resource.data.replyCount == resource.data.replyCount - 1
        );
    }

    function findingTagOk(value) {
      return value == 'barrier'
        || value == 'theme'
        || value == 'anomaly'
        || value == 'recommendation';
    }

    function findingStatusOk(value) {
      return value == 'draft' || value == 'reviewed' || value == 'final';
    }

    function findingNoteShapeOk() {
      return request.resource.data.keys().hasAll([
          'title', 'body', 'tag', 'status', 'questionId',
          'authorUid', 'authorName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 2000
        && findingTagOk(request.resource.data.tag)
        && findingStatusOk(request.resource.data.status)
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() >= 1
        && request.resource.data.questionId.size() <= 80
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 120;
    }

    function findingNoteFinalUnlock() {
      return resource.data.status == 'final'
        && request.resource.data.status == 'draft'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    function inviteDoc(inviteId) {
      return get(/databases/$(database)/documents/invites/$(inviteId)).data;
    }

    function emailMatches(stored) {
      // Auth emails are normalized; invites/admins store the Auth email string.
      return stored == request.auth.token.email;
    }

    function creatingPendingSelf() {
      return request.resource.data.status == 'pending'
        && request.resource.data.role == null
        && emailMatches(request.resource.data.email)
        && request.resource.data.keys().hasAll([
          'fullName', 'email', 'requestedRole', 'role', 'status', 'permissions', 'createdAt'
        ]);
    }

    function creatingFromInvite() {
      return request.resource.data.keys().hasAll(['inviteId'])
        && request.resource.data.status == 'active'
        && emailMatches(request.resource.data.email)
        && emailMatches(inviteDoc(request.resource.data.inviteId).email)
        && inviteDoc(request.resource.data.inviteId).used == false
        && request.resource.data.role == inviteDoc(request.resource.data.inviteId).role;
    }

    // Manual Console bootstrap often uses the wrong document ID. Allow copying an
    // already-active profile for this email onto admins/{auth.uid}.
    function linkingFromExistingEmailDoc() {
      return request.resource.data.keys().hasAll([
          'linkedFromDocumentId', 'fullName', 'email', 'requestedRole',
          'role', 'status', 'permissions'
        ])
        && request.resource.data.status == 'active'
        && (request.resource.data.role == 'admin'
          || request.resource.data.role == 'adviser'
          || request.resource.data.role == 'superadmin')
        && emailMatches(request.resource.data.email)
        && exists(/databases/$(database)/documents/admins/$(request.resource.data.linkedFromDocumentId))
        && get(/databases/$(database)/documents/admins/$(request.resource.data.linkedFromDocumentId)).data.email
          == request.auth.token.email
        && get(/databases/$(database)/documents/admins/$(request.resource.data.linkedFromDocumentId)).data.status
          == 'active'
        && get(/databases/$(database)/documents/admins/$(request.resource.data.linkedFromDocumentId)).data.role
          == request.resource.data.role;
    }

    match /admins/{uid} {
      // Proponents/superadmins may read the member directory (roles/emails).
      // Advisers may only read their own profile (or an email-matched doc).
      // Mutations that grant/remove roles stay superadmin-only below.
      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || emailMatches(resource.data.email)
          || isActiveProponentOrSuperadmin()
          || isActiveSuperadmin(request.auth.uid)
        );

      allow create: if request.auth != null
        && request.auth.uid == uid
        && (creatingPendingSelf() || creatingFromInvite() || linkingFromExistingEmailDoc());

      allow update: if request.auth != null && (
        isActiveSuperadmin(request.auth.uid) ||
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'status', 'permissions', 'approvedAt', 'approvedBy', 'updatedAt', 'removedAt', 'removedBy', 'inviteId']))
      );

      // Pending reject, or hard-delete of already-removed historical records.
      // Active accounts cannot be hard-deleted (soft-remove only).
      allow delete: if request.auth != null
        && isActiveSuperadmin(request.auth.uid)
        && (resource.data.status == 'pending' || resource.data.status == 'removed');
    }

    // Tight invite rules: no open read for every signed-in user.
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        isActiveSuperadmin(request.auth.uid)
        || emailMatches(resource.data.email)
      );

      allow create: if request.auth != null && isActiveSuperadmin(request.auth.uid);

      allow update: if request.auth != null && (
        isActiveSuperadmin(request.auth.uid)
        || (
          emailMatches(resource.data.email)
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt'])
        )
      );

      // Superadmin may revoke an unused invite (wrong email/role).
      allow delete: if request.auth != null
        && isActiveSuperadmin(request.auth.uid)
        && resource.data.used == false;
    }

    // Open, and inside the optional schedule window (opensAt / closesAt).
    function surveyAcceptsResponses() {
      return !exists(/databases/$(database)/documents/appConfig/survey)
        || (
          get(/databases/$(database)/documents/appConfig/survey).data.status == 'open'
          && (get(/databases/$(database)/documents/appConfig/survey).data.get('opensAt', null) == null
            || request.time >= get(/databases/$(database)/documents/appConfig/survey).data.get('opensAt', null))
          && (get(/databases/$(database)/documents/appConfig/survey).data.get('closesAt', null) == null
            || request.time < get(/databases/$(database)/documents/appConfig/survey).data.get('closesAt', null))
        );
    }

    // Audit trail of survey-control changes. Superadmin only.
    match /surveyConfigHistory/{entryId} {
      allow read: if request.auth != null && isActiveSuperadmin(request.auth.uid);
      allow create: if request.auth != null && isActiveSuperadmin(request.auth.uid);
      allow update, delete: if false;
    }

    match /needsAssessmentResponses/{responseId} {
      allow create: if surveyAcceptsResponses();
      allow read, update: if isActiveAdmin();
      // Hard-deleting research data is not an adviser action.
      allow delete: if isActiveProponentOrSuperadmin();
    }

    match /interviewInterest/{invitationId} {
      allow create: if true;
      allow read, update: if isActiveAdmin();
      allow delete: if isActiveProponentOrSuperadmin();
    }

    match /responses/{responseId} {
      allow create: if true;
      allow read, update, delete: if isActiveAdmin();
    }

    match /interview_contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isActiveAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      // Public inbox — proponents and superadmins only (not advisers).
      allow read, update, delete: if isActiveProponentOrSuperadmin();
    }

    // Analysis findings log — active team may read; proponents/superadmins write.
    match /findingNotes/{noteId} {
      allow read: if isActiveAdmin();

      allow create: if isActiveProponentOrSuperadmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && findingNoteShapeOk();

      allow update: if isActiveProponentOrSuperadmin()
        && (request.auth.uid == resource.data.authorUid
          || isActiveSuperadmin(request.auth.uid))
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && findingNoteShapeOk()
        && (resource.data.status != 'final' || findingNoteFinalUnlock());

      allow delete: if isActiveProponentOrSuperadmin()
        && (request.auth.uid == resource.data.authorUid
          || isActiveSuperadmin(request.auth.uid))
        && resource.data.status != 'final';
    }

    // Adviser review threads. Deleting a root is blocked while replyCount > 0
    // (delete replies first). Replies do not carry severity or status.
    match /adviserFeedback/{commentId} {
      allow read: if isActiveAdmin();

      allow create: if feedbackRootCreateOk() || feedbackReplyCreateOk();

      allow update: if isActiveAdmin()
        && (feedbackCommentEditOk() || feedbackStatusChangeOk() || feedbackReplyCountOk());

      allow delete: if isActiveAdmin()
        && (resource.data.authorUid == request.auth.uid
          || isActiveSuperadmin(request.auth.uid))
        && (
          resource.data.parentId is string
          || (resource.data.parentId == null && resource.data.replyCount == 0)
        );
    }

    // Signup access code + survey window (public read; superadmin write).
    // Survey doc may be deleted to restore open defaults. Signup code is never deleted here.
    match /appConfig/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && isActiveSuperadmin(request.auth.uid)
        && (docId == 'signup' || docId == 'survey');
      allow delete: if request.auth != null
        && isActiveSuperadmin(request.auth.uid)
        && docId == 'survey';
    }
  }
}
